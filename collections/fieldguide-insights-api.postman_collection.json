        {
          "id": "6eed9308-4fa9-4879-bf63-b67312195cfa",
          "name": "Export an Insights Time Tracking report",
          "request": {
            "name": "Export an Insights Time Tracking report",
            "description": {
              "content": "Begins a long-running process that will generate an Insights Time Tracking report in CSV format.\n\nUse the Job ID that this endpoint returns with the appropriate [jobs endpoint](#/jobs/get_job_v1) to check its status and get its result.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "insights",
                "teams",
                "time-tracking",
                "export"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"report_start\": \"<string>\",\n  \"report_end\": \"<string>\"\n}",
