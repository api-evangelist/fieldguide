              {
                "name": "parent_folder_uuid",
                "value": "",
                "type": "query",
                "description": "An optional UUID of the parent folder"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort_order",
                "value": "",
