{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fieldguide api controls API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "controls",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Controls that belong to the specified Request",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fieldguide.io/v1/requests/:uuid/controls",
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "The UUID of the request to retrieve controls for"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort_order",
                "value": "",
                "type": "query",
                "description": "Sort order for paginated results. Use `desc` to reverse the default ascending order."
              }
            ]
          },
          "docs": "List Controls that belong to the specified Request"
        }
      ]
    }
  ],
  "bundled": true
}