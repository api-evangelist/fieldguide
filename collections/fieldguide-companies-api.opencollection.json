                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "The UUID of the Company to retrieve engagements from"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort_order",
                "value": "",
                "type": "query",
                "description": "Sort order for paginated results. Use `desc` to reverse the default ascending order."
