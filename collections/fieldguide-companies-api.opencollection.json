                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "The UUID of the Company to update"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update the specified Company"
        },
        {
          "info": {
