              {
                "name": "email",
                "value": "",
                "type": "query",
                "description": "Filter Users by email address (case-insensitive, partial match)"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "per_page",
                "value": "",
