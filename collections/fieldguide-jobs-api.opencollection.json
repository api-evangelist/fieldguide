{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fieldguide api jobs API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "jobs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Return the status of an asynchronous Job",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fieldguide.io/v1/jobs/:uuid",
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "UUID of the Job"
              }
            ]
          },
          "docs": "Return the status of an asynchronous Job"
        }
      ]
    }
  ],
  "bundled": true
}